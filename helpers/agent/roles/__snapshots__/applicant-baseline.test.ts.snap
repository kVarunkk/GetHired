# User profile
<user_profile>
Name: Ada Lovelace
AI credits: 12
Desired roles: Frontend Engineer
Preferred locations: Remote, Bengaluru
Salary range: 1500000–2500000 INR
Experience: 4 years
Top skills: React, TypeScript
Job types: Fulltime
Needs visa sponsorship: no
Work style: Remote
Short-term goal: Lead a small frontend team
</user_profile>

# Onboarding
The user hasn't finished onboarding, so personalised matches and some features (like interviews) won't work yet. Early in the conversation, offer to set up their profile here in the chat.
- Ask for the missing details a few at a time (two or three per message), not as one long questionnaire. Use what the profile and conversation already say.
- Required: full name, desired roles, job types, salary currency and minimum salary, preferred locations, years of experience, top skills, work style, company size preference, and a resume. Optional: LinkedIn and GitHub URLs, maximum salary, industries, career goals, visa sponsorship.
- For the resume, check listResumes; if there's none, call requestResumeUpload.
- Then call completeOnboarding once with everything. If the user would rather use the form, link them to /get-started.

# Saved memories
No saved memories.",
  },
  "schemas": {
    "completeOnboarding": {
      "description": "Finish the user's onboarding with their profile and resume, the same as the /get-started form. Only for users whose profile shows onboarding isn't complete; gather the required fields first. The user must approve.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "careerGoalsLongTerm": {
            "maxLength": 500,
            "type": "string",
          },
          "careerGoalsShortTerm": {
            "maxLength": 500,
            "type": "string",
          },
          "companySizePreference": {
            "enum": [
              "Small (1-50)",
              "Medium (51-500)",
              "Large (500+)",
              "Any",
            ],
            "type": "string",
          },
          "desiredRoles": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "experienceYears": {
            "maximum": 60,
            "minimum": 0,
            "type": "number",
          },
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
          },
          "githubUrl": {
            "format": "uri",
            "type": "string",
          },
          "industryPreferences": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "jobTypes": {
            "items": {
              "enum": [
                "Fulltime",
                "Contract",
                "Intern",
              ],
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "linkedinUrl": {
            "format": "uri",
            "type": "string",
          },
          "maxSalary": {
            "minimum": 0,
            "type": "integer",
          },
          "minSalary": {
            "description": "Minimum yearly salary as a plain integer.",
            "minimum": 0,
            "type": "integer",
          },
          "preferredLocations": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "resumeId": {
            "description": "From requestResumeUpload or listResumes; omit to use the primary resume.",
            "format": "uuid",
            "type": "string",
          },
          "salaryCurrency": {
            "enum": [
              "₹",
              "$",
              "€",
              "£",
              "C$",
              "A$",
            ],
            "type": "string",
          },
          "topSkills": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array",
          },
          "visaSponsorshipRequired": {
            "type": "boolean",
          },
          "workStylePreferences": {
            "description": "e.g. Remote, Hybrid, On-site, Startup Environment.",
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "fullName",
          "desiredRoles",
          "jobTypes",
          "salaryCurrency",
          "minSalary",
          "preferredLocations",
          "experienceYears",
          "topSkills",
          "workStylePreferences",
          "companySizePreference",
        ],
        "type": "object",
      },
    },
    "createInterview": {
      "description": "Set up an AI mock interview for a job, using a resume (the primary one by default). Free to create; the user starts it from the returned link, and each session uses 10 AI credits when it starts.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "name": {
            "description": "Optional name for the interview.",
            "maxLength": 80,
            "minLength": 1,
            "type": "string",
          },
          "resumeId": {
            "description": "Omit to use the primary resume.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
    },
    "deleteMemory": {
      "description": "Forget a saved memory that is no longer true.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "memoryId": {
            "description": "The memory's id, exactly as shown in brackets in the saved memories list.",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$",
            "type": "string",
          },
        },
        "required": [
          "memoryId",
        ],
        "type": "object",
      },
    },
    "findRelevantJobs": {
      "description": "Find jobs matched to the user's profile and primary resume, best matches first. Needs at least 5 AI credits but does not spend them.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "filters": {
            "additionalProperties": false,
            "description": "Optional filters to narrow the matches.",
            "properties": {
              "companies": {
                "items": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
              "jobTypes": {
                "items": {
                  "enum": [
                    "Fulltime",
                    "Contract",
                    "Intern",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
              "keywords": {
                "description": "Job title keywords, including common variants, e.g. ['frontend', 'front-end', 'front end']. Leave out seniority words such as junior, senior, lead or fresher: use minExperience/maxExperience.",
                "items": {
                  "maxLength": 50,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
              "locations": {
                "description": "Locations, e.g. ['Remote', 'Bengaluru'].",
                "items": {
                  "maxLength": 60,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
              "maxExperience": {
                "description": "Upper end of the user's experience range in years: only jobs requiring at most this much. Seniority maps to the experience range, not to keywords: fresher/entry level is maxExperience 1, junior is maxExperience 2, mid level is minExperience 2 and maxExperience 5, senior is minExperience 5.",
                "maximum": 30,
                "minimum": 0,
                "type": "integer",
              },
              "minExperience": {
                "description": "Lower end of the user's experience range in years. Jobs match when their experience range overlaps the user's. Seniority maps to the experience range, not to keywords: fresher/entry level is maxExperience 1, junior is maxExperience 2, mid level is minExperience 2 and maxExperience 5, senior is minExperience 5.",
                "maximum": 30,
                "minimum": 0,
                "type": "integer",
              },
              "minSalary": {
                "description": "Minimum salary as a plain integer.",
                "minimum": 0,
                "type": "integer",
              },
              "platforms": {
                "description": "Job source platforms.",
                "items": {
                  "enum": [
                    "greenhouse",
                    "jazzhr",
                    "ashby",
                    "rippling",
                    "workable",
                    "recruitee",
                    "personio",
                    "bamboohr",
                    "jobvite",
                    "workday",
                    "keka",
                    "gethired",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
              "postedWithinDays": {
                "description": "Only jobs posted within this many days.",
                "maximum": 90,
                "minimum": 1,
                "type": "integer",
              },
              "visaRequirements": {
                "items": {
                  "enum": [
                    "Will Sponsor",
                    "Not Required",
                    "Required",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
            },
            "type": "object",
          },
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
    },
    "findSimilarJobs": {
      "description": "Find jobs similar to a given job. May spend 5 AI credits to re-rank results with AI when the user has enough credits.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
    },
    "getApplicationForm": {
      "description": "Read the application form of a job on GetHired (isPlatformJob), before applying with submitApplication: each field's key, label, type, whether it's required and its options or limits, plus suggested answers from the user's profile and the resume that would be sent.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
    },
    "getInterviewAnalysis": {
      "description": "Get the feedback from one AI interview session: overall feedback, communication and role-fit scores (1-5), strengths, areas to improve and practice tips. Defaults to the latest session.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "interviewId": {
            "description": "The interview id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "sessionId": {
            "description": "A session id from listInterviews; omit for the latest session.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "interviewId",
        ],
        "type": "object",
      },
    },
    "getJobDetails": {
      "description": "Get full details of one job: description, experience, visa, salary and links, including applyUrl for applying on GetHired.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
    },
    "getMyProfile": {
      "description": "Get the user's name, AI credit balance, onboarding status, weekly activity and three most recent applications.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {},
        "type": "object",
      },
    },
    "getResumeReview": {
      "description": "Get a resume review's status, score, overall feedback and its top suggestions (highest priority first).",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "reviewId": {
            "description": "The resume review id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "reviewId",
        ],
        "type": "object",
      },
    },
    "listApplications": {
      "description": "List the user's job applications with their status, newest first. isPlatformJob tells whether the job was applied to through GetHired.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
          "status": {
            "description": "Only applications with this status.",
            "enum": [
              "submitted",
              "reviewed",
              "selected",
              "stand_by",
              "rejected",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "listInterviews": {
      "description": "List the user's AI mock interviews, newest first: the job and resume each is for, and each session taken with its analysis status (completed, processing, failed, or null when none).",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
    },
    "listResumes": {
      "description": "List the user's uploaded resumes with whether each is primary and ready (parsed), processing, or failed.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {},
        "type": "object",
      },
    },
    "listSavedJobs": {
      "description": "List the jobs the user has saved.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
    },
    "listScreeningInterviews": {
      "description": "List the screening interviews companies have invited the user to after they applied, newest first: the job and company, the status (invited, paused, in_progress, completed, expired, declined, cancelled or withdrawn), the deadline, length and attempts left. These are separate from mock interviews. The company keeps the report; the user doesn't see a score.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
    },
    "naturalLanguageJobSearch": {
      "description": "Turn a plain-English job request into filters with AI, then search. Costs 5 AI credits per call; prefer searchJobs when you can build the filters yourself.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "The user's request in their words.",
            "maxLength": 300,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
    },
    "pickResumeForJob": {
      "description": "Compare the user's resumes against a job (jobId) or a pasted job description and pick the one that fits best, with the job requirements each covers and misses. Pass resumeIds to compare specific resumes; otherwise all ready resumes are compared. With more than 5, the closest 5 are shortlisted first and only those are compared in detail. Costs 1 AI credit when two or more resumes are compared; free with one.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobDescription": {
            "description": "A job description the user pasted, when there is no jobId.",
            "maxLength": 4000,
            "minLength": 50,
            "type": "string",
          },
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "resumeIds": {
            "description": "Only when the user names which resumes to compare (2 to 50, from listResumes). Leave out to compare all of them.",
            "items": {
              "description": "The resume id, exactly as returned by another tool.",
              "format": "uuid",
              "type": "string",
            },
            "maxItems": 50,
            "minItems": 2,
            "type": "array",
          },
        },
        "type": "object",
      },
    },
    "requestResumeUpload": {
      "description": "Ask the user to upload a resume (PDF). The app shows an upload widget; the result is the new resumeId, or cancelled if the user dismissed it.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "Short reason shown to the user, e.g. 'so I can review it'.",
            "maxLength": 200,
            "type": "string",
          },
        },
        "type": "object",
      },
    },
    "saveJob": {
      "description": "Save (bookmark) a job for the user.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
    },
    "saveMemory": {
      "description": "Remember a durable fact about the user that their profile has no field for (e.g. companies to avoid, ongoing interviews). Pass memoryId to update an existing memory instead of adding a duplicate.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "preference",
              "goal",
              "constraint",
              "fact",
            ],
            "type": "string",
          },
          "content": {
            "description": "The fact, written as a short statement about the user.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "memoryId": {
            "description": "Id of a saved memory to update.",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$",
            "type": "string",
          },
        },
        "required": [
          "content",
          "category",
        ],
        "type": "object",
      },
    },
    "searchJobs": {
      "description": "Search GetHired's job listings with structured filters. Free. Returns compact jobs with ids; use nextCursor to page.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "companies": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "cursor": {
            "description": "nextCursor from a previous searchJobs call.",
            "type": "string",
          },
          "jobTypes": {
            "items": {
              "enum": [
                "Fulltime",
                "Contract",
                "Intern",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "keywords": {
            "description": "Job title keywords, including common variants, e.g. ['frontend', 'front-end', 'front end']. Leave out seniority words such as junior, senior, lead or fresher: use minExperience/maxExperience.",
            "items": {
              "maxLength": 50,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "limit": {
            "description": "How many results to return (default 10).",
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
          },
          "locations": {
            "description": "Locations, e.g. ['Remote', 'Bengaluru'].",
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "maxExperience": {
            "description": "Upper end of the user's experience range in years: only jobs requiring at most this much. Seniority maps to the experience range, not to keywords: fresher/entry level is maxExperience 1, junior is maxExperience 2, mid level is minExperience 2 and maxExperience 5, senior is minExperience 5.",
            "maximum": 30,
            "minimum": 0,
            "type": "integer",
          },
          "minExperience": {
            "description": "Lower end of the user's experience range in years. Jobs match when their experience range overlaps the user's. Seniority maps to the experience range, not to keywords: fresher/entry level is maxExperience 1, junior is maxExperience 2, mid level is minExperience 2 and maxExperience 5, senior is minExperience 5.",
            "maximum": 30,
            "minimum": 0,
            "type": "integer",
          },
          "minSalary": {
            "description": "Minimum salary as a plain integer.",
            "minimum": 0,
            "type": "integer",
          },
          "platforms": {
            "description": "Job source platforms.",
            "items": {
              "enum": [
                "greenhouse",
                "jazzhr",
                "ashby",
                "rippling",
                "workable",
                "recruitee",
                "personio",
                "bamboohr",
                "jobvite",
                "workday",
                "keka",
                "gethired",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "postedWithinDays": {
            "description": "Only jobs posted within this many days.",
            "maximum": 90,
            "minimum": 1,
            "type": "integer",
          },
          "visaRequirements": {
            "items": {
              "enum": [
                "Will Sponsor",
                "Not Required",
                "Required",
              ],
              "type": "string",
            },
            "type": "array",
          },
        },
        "type": "object",
      },
    },
    "setPrimaryResume": {
      "description": "Make one of the user's resumes their primary resume. Personalised job matches use the primary resume.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "resumeId": {
            "description": "The resume id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "resumeId",
        ],
        "type": "object",
      },
    },
    "startResumeReview": {
      "description": "Start an AI review of one of the user's resumes against a job (jobId) or a pasted job description. Costs 5 AI credits once the analysis succeeds; the user must approve. Runs in the background and returns a link.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobDescription": {
            "description": "A job description the user pasted, when there is no jobId.",
            "maxLength": 4000,
            "minLength": 50,
            "type": "string",
          },
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "name": {
            "description": "Optional name for the review.",
            "maxLength": 80,
            "minLength": 1,
            "type": "string",
          },
          "resumeId": {
            "description": "The resume id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "resumeId",
        ],
        "type": "object",
      },
    },
    "submitApplication": {
      "description": "Apply to a job on GetHired for the user (Easy Apply) with their answers to its application form. Costs 1 AI credit, and the user approves it first. Read the form with getApplicationForm first. Only use answers the user gave or that come from their profile; ask them for anything else.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "answers": {
            "description": "One entry per field you answer. Leave out optional fields the user has nothing for.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "choices": {
                  "description": "For multi_select fields only: the chosen options.",
                  "items": {
                    "maxLength": 120,
                    "type": "string",
                  },
                  "maxItems": 30,
                  "type": "array",
                },
                "key": {
                  "description": "The field's key, exactly as getApplicationForm returned it.",
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string",
                },
                "value": {
                  "description": "The answer as text: yes/no for yes_no, digits for number, YYYY-MM-DD for date, an http(s) link for url, one of the options for single_select, and amount plus 3-letter currency for salary (e.g. 1500000 INR).",
                  "maxLength": 5000,
                  "type": "string",
                },
              },
              "required": [
                "key",
              ],
              "type": "object",
            },
            "maxItems": 40,
            "type": "array",
          },
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "resumeId": {
            "description": "The resume to send, from listResumes. Leave out to send the primary resume.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "jobId",
          "answers",
        ],
        "type": "object",
      },
    },
    "unsaveJob": {
      "description": "Remove a job from the user's saved jobs.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
    },
    "updateApplicationStatus": {
      "description": "Track the status of the user's application to an external (non-GetHired) job, e.g. after they applied on the company site or heard back. Creates the application record if needed. Not allowed for jobs applied to through GetHired, whose status is set by the company.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job id, exactly as returned by another tool.",
            "format": "uuid",
            "type": "string",
          },
          "status": {
            "enum": [
              "submitted",
              "reviewed",
              "selected",
              "stand_by",
              "rejected",
            ],
            "type": "string",
          },
        },
        "required": [
          "jobId",
          "status",
        ],
        "type": "object",
      },
    },
    "updateMyPreferences": {
      "description": "Update the user's job preferences on their profile (roles, locations, salary, job types, visa, skills, work style). Personalised matches are refreshed afterwards. The user must approve. Send only the fields that change.",
      "input": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "desiredRoles": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "jobTypes": {
            "items": {
              "enum": [
                "Fulltime",
                "Contract",
                "Intern",
              ],
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "maxSalary": {
            "minimum": 0,
            "type": "integer",
          },
          "minSalary": {
            "minimum": 0,
            "type": "integer",
          },
          "preferredLocations": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "salaryCurrency": {
            "enum": [
              "₹",
              "$",
              "€",
              "£",
              "C$",
              "A$",
            ],
            "type": "string",
          },
          "topSkills": {
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array",
          },
          "visaSponsorshipRequired": {
            "type": "boolean",
          },
          "workStylePreferences": {
            "description": "e.g. Remote, Hybrid, On-site, Startup Environment, Fast-paced.",
            "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
        },
        "type": "object",
      },
    },
  },
}
`;
