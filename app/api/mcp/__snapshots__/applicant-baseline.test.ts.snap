              "type": {
                "enum": [
                  "summary",
                  "experience",
                  "projects",
                  "skills",
                  "education",
                  "achievements",
                  "certifications",
                  "languages",
                  "publications",
                  "volunteering",
                  "awards",
                  "other",
                ],
                "type": "string",
              },
            },
            "required": [
              "type",
              "items",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
