  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Resume review details",
    },
    "description": "Get a resume review's status, score, overall feedback and its top changes of every kind (pending first, then highest priority), each with the id that apply_review_suggestions needs, any [placeholders] the user must fill in, and its state on the copy and on the original resume (pending, applied, or changed if the resume moved on since the review).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "reviewId": {
          "description": "The review to read: an id from get_resume_reviews, or the reviewId from improve_resume.",
          "format": "uuid",
          "type": "string",
        },
      },
      "required": [
        "reviewId",
      ],
      "type": "object",
    },
    "name": "get_resume_review_details",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "copyResumeId": {
          "description": "The copy the changes go to by default, once one exists.",
          "type": [
            "string",
            "null",
          ],
        },
        "createdAt": {
          "type": [
            "string",
            "null",
          ],
        },
        "id": {
          "type": "string",
        },
        "name": {
          "type": [
            "string",
            "null",
          ],
        },
        "overallFeedback": {
          "type": [
            "string",
            "null",
          ],
        },
        "pendingOnCopy": {
          "type": "integer",
        },
        "pendingOnOriginal": {
          "type": "integer",
        },
        "score": {
          "type": [
            "number",
            "null",
          ],
        },
        "status": {
          "enum": [
            "draft",
            "processing",
            "completed",
            "failed",
          ],
          "type": "string",
        },
        "suggestions": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "description": "Pass to apply_review_suggestions.",
                "type": "string",
              },
              "kind": {
                "enum": [
                  "rewrite",
                  "add",
                  "remove",
                  "move",
                ],
                "type": "string",
              },
              "onCopy": {
                "description": "pending, applied, changed, or unknown when that resume is gone.",
                "type": "string",
              },
              "onOriginal": {
                "description": "pending, applied, changed, or unknown when that resume is gone.",
                "type": "string",
              },
              "original": {
                "description": "The bullet's current text, for rewrites and removals.",
                "type": "string",
