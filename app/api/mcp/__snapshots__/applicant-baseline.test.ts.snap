  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Finish onboarding",
    },
    "description": "Finish the user's GetHired onboarding with their profile and resume, the same as the /get-started form. Only for users whose profile (get_my_profile) shows onboarding isn't complete; gather the required fields first. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "careerGoalsLongTerm": {
          "description": "Where the user wants their career to go in the longer term, in their own words.",
          "maxLength": 500,
          "type": "string",
        },
        "careerGoalsShortTerm": {
          "description": "What the user wants from their next role, in their own words.",
          "maxLength": 500,
          "type": "string",
        },
        "companySizePreference": {
          "description": "The size of company the user prefers to work at. Any when they have no preference.",
          "enum": [
            "Small (1-50)",
            "Medium (51-500)",
            "Large (500+)",
            "Any",
          ],
          "type": "string",
        },
        "confirmation_token": {
          "description": "Leave out on the first call, which returns a preview and this token. Once the user approves the preview, call again with the same input plus the token.",
          "type": "string",
        },
        "desiredRoles": {
          "description": "Job titles the user is looking for, e.g. ['Frontend Engineer', 'UI Developer'].",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "experienceYears": {
          "description": "The user's total work experience in whole years, rounded to the nearest year: 6 months counts as 1, 2 months as 0.",
          "maximum": 60,
          "minimum": 0,
          "type": "integer",
        },
        "fullName": {
          "description": "The user's full name, as it should appear on their profile.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
        "githubUrl": {
          "description": "The full link to the user's GitHub profile.",
          "format": "uri",
          "type": "string",
        },
        "industryPreferences": {
          "description": "Industries the user wants to work in, e.g. ['Fintech', 'Healthcare'].",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "jobTypes": {
          "description": "The kinds of employment the user wants: full-time, contract or internship.",
          "items": {
            "enum": [
              "Fulltime",
              "Contract",
              "Intern",
            ],
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "linkedinUrl": {
          "description": "The full link to the user's LinkedIn profile.",
          "format": "uri",
          "type": "string",
        },
        "maxSalary": {
          "description": "The top of the user's yearly salary range, as a plain whole number in salaryCurrency.",
          "minimum": 0,
          "type": "integer",
        },
        "minSalary": {
          "description": "The bottom of the user's yearly salary range, as a plain whole number in salaryCurrency.",
          "minimum": 0,
          "type": "integer",
        },
        "preferredLocations": {
          "description": "Where the user wants to work, e.g. ['Remote', 'Bengaluru']. City names are saved in their standard spelling.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "resumeId": {
          "description": "The resume to onboard with: an id from get_resumes. Leave out to use the primary resume. The user uploads resumes on GetHired's /resume page.",
          "format": "uuid",
          "type": "string",
        },
        "salaryCurrency": {
          "description": "The currency of minSalary and maxSalary: ₹ rupees, $ US dollars, € euros, £ pounds, C$ Canadian dollars, A$ Australian dollars.",
          "enum": [
            "₹",
            "$",
            "€",
            "£",
            "C$",
            "A$",
          ],
          "type": "string",
        },
        "topSkills": {
          "description": "The user's main skills, e.g. ['React', 'TypeScript', 'Figma'].",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array",
        },
        "visaSponsorshipRequired": {
          "description": "true when the user needs an employer to sponsor their visa or work permit.",
          "type": "boolean",
        },
        "workStylePreferences": {
          "description": "How the user likes to work, e.g. Remote, Hybrid, On-site, Startup Environment, Fast-paced.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "fullName",
        "desiredRoles",
        "jobTypes",
        "salaryCurrency",
        "minSalary",
        "preferredLocations",
        "experienceYears",
        "topSkills",
        "workStylePreferences",
        "companySizePreference",
      ],
      "type": "object",
    },
    "name": "complete_onboarding",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "confirmation_token": {
          "description": "Send back with the same input to run it after the user approves.",
          "type": "string",
        },
        "instruction": {
          "type": "string",
        },
        "message": {
          "description": "What happened, e.g. that the user declined and nothing was done.",
          "type": "string",
        },
        "needsConfirmation": {
          "description": "true when nothing ran yet: show preview to the user, and call again with confirmation_token once they approve.",
          "type": "boolean",
        },
        "onboarded": {
          "type": "boolean",
        },
        "preferredLocations": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "preview": {
          "description": "What will happen, for the user to approve.",
          "type": "string",
        },
        "resume": {
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
            },
            "name": {
              "type": [
                "string",
                "null",
              ],
            },
          },
          "required": [
            "id",
            "name",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "title": "Finish onboarding",
  },
