  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Improve a resume",
    },
    "description": "Suggest how to improve or tailor one of the user's resumes: rewrites, new bullets, removals, moves, and gaps to ask the user about, each change with its id. Pass a jobId or a pasted jobDescription to tailor it to a job, or neither to judge it on its own. It changes nothing: apply the ones the user chooses with apply_review_suggestions. Costs 2 AI credits once it succeeds.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "focus": {
          "description": "What the user asked for, in their words, such as 'make it shorter' or 'focus on leadership'.",
          "maxLength": 300,
          "type": "string",
        },
        "jobDescription": {
          "description": "The text of a job description the user pasted, to tailor the resume to a job that isn't on GetHired. Don't send it with jobId.",
          "maxLength": 4000,
          "minLength": 50,
          "type": "string",
        },
        "jobId": {
          "description": "A job to tailor the resume to: an id from search_jobs, get_relevant_jobs, get_saved_jobs or another job list. Leave out, with jobDescription, for a general review.",
          "format": "uuid",
          "type": "string",
        },
        "resumeId": {
          "description": "The resume to improve: an id from get_resumes.",
          "format": "uuid",
          "type": "string",
        },
      },
      "required": [
        "resumeId",
      ],
      "type": "object",
    },
    "name": "improve_resume",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "changes": {
          "description": "The suggested changes as JSON, delimited as data: each one's id, kind, reason, priority and text.",
          "type": "string",
        },
        "counts": {
          "additionalProperties": true,
          "properties": {
            "additions": {
              "type": "integer",
            },
            "gaps": {
              "type": "integer",
            },
            "moves": {
              "type": "integer",
            },
            "removals": {
              "type": "integer",
            },
            "rewrites": {
              "type": "integer",
            },
          },
          "required": [
            "rewrites",
            "additions",
            "removals",
            "moves",
            "gaps",
          ],
          "type": "object",
        },
        "gaps": {
          "description": "Questions for the user about what the resume is missing, as JSON, delimited as data.",
          "type": "string",
        },
        "message": {
          "type": "string",
        },
        "reviewId": {
          "description": "Pass to apply_review_suggestions.",
          "type": "string",
        },
        "summary": {
          "description": "The review's summary, delimited as data.",
          "type": "string",
        },
        "tailoredFor": {
          "description": "What the review was tailored to, delimited as data.",
          "type": "string",
        },
      },
      "required": [
        "reviewId",
        "tailoredFor",
        "summary",
        "counts",
        "gaps",
        "changes",
        "message",
      ],
      "type": "object",
    },
    "title": "Improve a resume",
  },
