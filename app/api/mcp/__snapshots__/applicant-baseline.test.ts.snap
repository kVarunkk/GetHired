[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Search jobs",
    },
    "description": "Search GetHired's job listings with structured filters. Free. Returns compact jobs with ids; use nextCursor to page.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "companies": {
          "description": "Only jobs at these companies, by company name, e.g. ['Stripe', 'Razorpay'].",
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "cursor": {
          "description": "For the next page: the nextCursor from the previous search_jobs result, sent with the same filters. Leave out for the first page.",
          "type": "string",
        },
        "jobTypes": {
          "description": "Only these kinds of employment: full-time, contract or internship.",
          "items": {
            "enum": [
              "Fulltime",
              "Contract",
              "Intern",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "keywords": {
          "description": "Words to look for in the job title. Add the common spellings of the same role, e.g. ['frontend', 'front-end', 'front end']. Put seniority (junior, senior, lead, fresher) in minExperience/maxExperience, not here.",
          "items": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "limit": {
          "description": "How many to return in this call. Defaults to 10.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "locations": {
          "description": "Where the user wants to work, e.g. ['Remote', 'Bengaluru']. Different spellings of a city, such as Bangalore and Bengaluru, find the same jobs.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "type": "array",
        },
        "maxExperience": {
          "description": "The top of the user's experience range, in years: only jobs asking for at most this much. Seniority maps to this range: fresher or entry level is maxExperience 1, junior is maxExperience 2, mid level is minExperience 2 with maxExperience 5, senior is minExperience 5.",
          "maximum": 30,
          "minimum": 0,
          "type": "integer",
        },
        "minExperience": {
          "description": "The bottom of the user's experience range, in years. A job matches when the experience it asks for overlaps the user's range. Seniority maps to this range: fresher or entry level is maxExperience 1, junior is maxExperience 2, mid level is minExperience 2 with maxExperience 5, senior is minExperience 5.",
          "maximum": 30,
          "minimum": 0,
          "type": "integer",
        },
        "minSalary": {
          "description": "The lowest salary the user would accept, as a plain whole number without a currency symbol or separators, e.g. 1500000.",
          "minimum": 0,
          "type": "integer",
        },
        "platforms": {
          "description": "Only jobs found on these applicant tracking systems or job boards. gethired is jobs posted on GetHired itself, which can be applied to with submit_application.",
          "items": {
            "enum": [
              "greenhouse",
              "jazzhr",
              "ashby",
              "rippling",
              "workable",
              "recruitee",
              "personio",
              "bamboohr",
              "jobvite",
              "workday",
              "keka",
              "gethired",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "postedWithinDays": {
          "description": "Only jobs posted in the last this many days, e.g. 7 for the past week.",
          "maximum": 90,
          "minimum": 1,
          "type": "integer",
        },
        "visaRequirements": {
          "description": "Only jobs whose posting states one of these visa terms. 'Will Sponsor' is for users who need the employer to sponsor a visa.",
          "items": {
            "enum": [
              "Will Sponsor",
