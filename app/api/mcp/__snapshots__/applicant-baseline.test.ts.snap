                  },
                  "text": {
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "itemId",
                  "text",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "bulletId": {
                    "type": "string",
                  },
                  "op": {
                    "const": "removeBullet",
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "bulletId",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
