  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a resume",
    },
    "description": "Create a new resume for the user from what they told you in this chat: ask them about the role, the sections they want and the details of each first. Blank only when they ask for an empty one. Never add anything they didn't say. Free; the user must approve. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirmation_token": {
          "description": "Leave out on the first call, which returns a preview and this token. Once the user approves the preview, call again with the same input plus the token.",
          "type": "string",
        },
        "name": {
          "description": "A name for the user to tell their resumes apart by, e.g. 'Frontend Engineer 2026'.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "sections": {
          "description": "The resume's sections, in order, with only what the user told you. Leave out for a blank resume.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "items": {
                "description": "The section's entries, such as each role, degree or project.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "bullets": {
                      "description": "The entry's bullet points, in order. An empty list when it has none.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "endDate": {
                      "description": "As the user wrote it, e.g. 'Present'.",
                      "type": "string",
                    },
                    "heading": {
                      "description": "A role, degree, project or skill group.",
                      "type": "string",
                    },
                    "location": {
                      "description": "Where it was, e.g. 'Bengaluru, India' or 'Remote'.",
                      "type": "string",
                    },
                    "startDate": {
                      "description": "As the user wrote it, e.g. 'Jan 2022'.",
                      "type": "string",
                    },
                    "subheading": {
                      "description": "A company or school.",
                      "type": "string",
                    },
                    "url": {
                      "description": "A link for the entry, such as a project's site or repository.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "bullets",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "title": {
                "description": "The heading as the user wrote it. Required for type 'other'.",
                "type": "string",
              },
              "type": {
                "description": "What the section holds. Use other, with a title, for a section that fits none of the rest.",
                "enum": [
                  "summary",
                  "experience",
                  "projects",
                  "skills",
                  "education",
                  "achievements",
                  "certifications",
                  "languages",
                  "publications",
                  "volunteering",
                  "awards",
                  "other",
                ],
                "type": "string",
              },
            },
            "required": [
              "type",
              "items",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "create_resume",
    "outputSchema": {
