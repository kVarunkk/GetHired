      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create a resume",
    },
    "description": "Create a new resume for the user: blank, or from what they told you in this chat. Never add anything they didn't say. Free; the user must approve. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirmation_token": {
          "description": "Only when confirming: the confirmation_token from this tool's earlier preview, sent with the same input once the user has said yes.",
          "type": "string",
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string",
        },
        "sections": {
          "description": "Only what the user gave you. Leave out for a blank resume.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "bullets": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "endDate": {
                      "description": "As the user wrote it, e.g. 'Present'.",
                      "type": "string",
                    },
                    "heading": {
                      "description": "A role, degree, project or skill group.",
                      "type": "string",
                    },
                    "location": {
                      "type": "string",
                    },
                    "startDate": {
                      "description": "As the user wrote it, e.g. 'Jan 2022'.",
                      "type": "string",
                    },
                    "subheading": {
                      "description": "A company or school.",
                      "type": "string",
                    },
                    "url": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "bullets",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "title": {
                "description": "The heading as the user wrote it. Required for type 'other'.",
                "type": "string",
