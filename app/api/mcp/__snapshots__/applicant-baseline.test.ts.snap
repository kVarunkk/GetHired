                        "type": "string",
                      },
                      "heading": {
                        "type": "string",
                      },
                      "location": {
                        "type": "string",
                      },
                      "startDate": {
                        "type": "string",
                      },
                      "subheading": {
                        "type": "string",
                      },
                      "url": {
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "itemId": {
                    "type": "string",
                  },
                  "op": {
                    "const": "setItemFields",
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "itemId",
                  "fields",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "bullets": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "fields": {
                    "additionalProperties": false,
                    "properties": {
                      "endDate": {
                        "type": "string",
                      },
                      "heading": {
                        "type": "string",
                      },
                      "location": {
                        "type": "string",
                      },
                      "startDate": {
                        "type": "string",
                      },
                      "subheading": {
                        "type": "string",
                      },
                      "url": {
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "index": {
                    "minimum": 0,
                    "type": "integer",
                  },
                  "op": {
                    "const": "addItem",
                    "type": "string",
                  },
                  "sectionId": {
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "sectionId",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                  },
                  "op": {
                    "const": "removeItem",
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "itemId",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
