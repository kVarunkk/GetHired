              "reason",
              "priority",
              "onCopy",
              "onOriginal",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "totalSuggestions": {
          "type": "integer",
        },
      },
      "required": [
        "id",
        "name",
        "status",
        "score",
        "overallFeedback",
        "totalSuggestions",
        "pendingOnCopy",
        "pendingOnOriginal",
        "copyResumeId",
        "createdAt",
        "suggestions",
