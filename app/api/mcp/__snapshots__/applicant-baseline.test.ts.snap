    "title": "Resume review details",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Pick a resume for a job",
    },
    "description": "Compare the user's resumes against a job (jobId) or a pasted job description and pick the one that fits best. Returns the best resume with its score (the share of the job's requirements it shows, 0-100), up to 3 requirements it matches with a quote from the resume and up to 3 it misses, then the other resumes compared, best first, each with its score and what it misses. Pass resumeIds to compare specific resumes; otherwise all ready resumes are compared, and with more than 5 only the closest 5 are compared in detail. Costs 1 AI credit when two or more resumes are compared; free with one.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "jobDescription": {
          "description": "The text of a job description the user pasted, for a job that isn't on GetHired. Send this or jobId, not both.",
          "maxLength": 4000,
          "minLength": 50,
          "type": "string",
        },
        "jobId": {
          "description": "The job to compare the resumes against: an id from search_jobs, get_relevant_jobs, get_saved_jobs or another job list. Send this or jobDescription, not both.",
          "format": "uuid",
          "type": "string",
        },
        "resumeIds": {
          "description": "Only when the user names which resumes to compare: their ids from get_resumes. Leave out to compare all of the user's ready resumes.",
          "items": {
            "description": "A resume id from get_resumes.",
            "format": "uuid",
            "type": "string",
          },
          "maxItems": 50,
          "minItems": 2,
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "pick_resume_for_job",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "best": {
          "additionalProperties": true,
          "description": "The best fit, with the requirements it matches and misses.",
          "properties": {
            "id": {
              "type": "string",
            },
            "matched": {
              "items": {
                "additionalProperties": true,
                "properties": {
                  "quote": {
                    "type": "string",
                  },
                  "requirement": {
                    "type": "string",
                  },
                },
                "required": [
                  "requirement",
                  "quote",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "missing": {
              "items": {
                "additionalProperties": true,
                "properties": {
                  "importance": {
                    "enum": [
                      "must",
                      "nice",
                    ],
                    "type": "string",
                  },
                  "text": {
                    "type": "string",
                  },
                },
                "required": [
