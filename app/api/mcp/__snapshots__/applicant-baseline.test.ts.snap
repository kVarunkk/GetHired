  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Apply review suggestions",
    },
    "description": "Apply changes from a resume review, by each change's id from improve_resume or get_resume_review_details. They go to a copy by default, which later applies reuse; pass target 'original' only when the user asks to change the reviewed resume. Pass text to use the user's own wording. Text with a [placeholder] is refused: ask the user for the real value, then pass it as text. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirmation_token": {
          "description": "Only when confirming: the confirmation_token from this tool's earlier preview, sent with the same input once the user has said yes.",
          "type": "string",
        },
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "The suggestion's id, from getResumeReview.",
                "type": "string",
              },
              "text": {
                "description": "The final text, when the user edited the suggestion or gave a real value for a placeholder.",
                "type": "string",
              },
            },
            "required": [
              "id",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "reviewId": {
          "description": "The resume review id, exactly as returned by another tool.",
          "format": "uuid",
          "type": "string",
        },
        "target": {
          "enum": [
            "copy",
            "original",
          ],
          "type": "string",
        },
      },
      "required": [
        "reviewId",
        "items",
      ],
      "type": "object",
    },
    "name": "apply_review_suggestions",
    "title": "Apply review suggestions",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Download a resume",
    },
    "description": "Get a link that downloads one of the user's resumes as a PDF or Word file. Give it to the user to open in a browser where they're signed in to GetHired. Free.",
    "inputSchema": {
