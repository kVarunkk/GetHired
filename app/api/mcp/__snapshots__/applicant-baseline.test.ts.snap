  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Delete a resume",
    },
    "description": "Delete one of the user's resumes, with its reviews. It can't be undone, and the last resume can't be deleted. The user must approve. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirmation_token": {
          "description": "Only when confirming: the confirmation_token from this tool's earlier preview, sent with the same input once the user has said yes.",
