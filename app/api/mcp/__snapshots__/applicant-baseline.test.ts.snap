                  "op": {
                    "const": "addSection",
                    "type": "string",
                  },
                  "sectionType": {
                    "enum": [
                      "summary",
                      "experience",
                      "projects",
                      "skills",
                      "education",
                      "achievements",
                      "certifications",
                      "languages",
                      "publications",
                      "volunteering",
                      "awards",
                      "other",
                    ],
                    "type": "string",
                  },
                  "title": {
                    "type": "string",
                  },
                },
                "required": [
                  "op",
                  "sectionType",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "setSectionTitle",
                    "type": "string",
                  },
                  "sectionId": {
                    "type": "string",
                  },
                  "title": {
                    "type": "string",
                  },
                },
                "required": [
