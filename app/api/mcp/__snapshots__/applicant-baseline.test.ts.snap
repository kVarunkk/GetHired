  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Apply review suggestions",
    },
    "description": "Apply changes from a resume review, by each change's id from improve_resume or get_resume_review_details. They go to a copy by default, which later applies reuse; pass target 'original' only when the user asks to change the reviewed resume. Pass text to use the user's own wording. Text with a [placeholder] is refused: ask the user for the real value, then pass it as text. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirmation_token": {
          "description": "Leave out on the first call, which returns a preview and this token. Once the user approves the preview, call again with the same input plus the token.",
          "type": "string",
        },
        "items": {
          "description": "The changes the user chose.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "The change's id, from improve_resume's changes or get_resume_review_details' suggestions.",
                "type": "string",
              },
              "text": {
                "description": "The final text, when the user edited the suggestion or gave a real value for a placeholder.",
                "type": "string",
              },
            },
            "required": [
              "id",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "reviewId": {
          "description": "The review the changes come from: the reviewId from improve_resume, or an id from get_resume_reviews.",
          "format": "uuid",
          "type": "string",
        },
        "target": {
          "description": "Where the changes go: copy (when left out) puts them on a copy of the reviewed resume, which later calls for this review reuse; original changes the reviewed resume itself, only when the user asks for that.",
          "enum": [
            "copy",
            "original",
          ],
          "type": "string",
        },
      },
      "required": [
        "reviewId",
        "items",
      ],
      "type": "object",
    },
    "name": "apply_review_suggestions",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "confirmation_token": {
          "description": "Send back with the same input to run it after the user approves.",
          "type": "string",
        },
        "instruction": {
          "type": "string",
        },
        "items": {
          "description": "Each change's result. changed means the resume moved on since the review, so it wasn't applied.",
          "items": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
              },
              "status": {
                "enum": [
                  "applied",
                  "already_applied",
                  "changed",
                  "not_found",
                ],
                "type": "string",
              },
            },
            "required": [
              "id",
              "status",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "message": {
          "description": "What happened, e.g. that the user declined and nothing was done.",
          "type": "string",
        },
        "needsConfirmation": {
          "description": "true when nothing ran yet: show preview to the user, and call again with confirmation_token once they approve.",
          "type": "boolean",
        },
        "preview": {
          "description": "What will happen, for the user to approve.",
          "type": "string",
        },
        "resumeId": {
          "description": "The resume the changes went to.",
          "type": [
            "string",
            "null",
          ],
        },
        "target": {
          "enum": [
            "copy",
            "original",
          ],
          "type": "string",
        },
        "url": {
          "description": "A full https link into GetHired.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "title": "Apply review suggestions",
  },
