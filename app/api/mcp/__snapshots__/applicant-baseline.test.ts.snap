  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update job preferences",
    },
    "description": "Update the user's job preferences on their profile (roles, locations, salary, job types, visa, skills, work style). Personalised matches are refreshed afterwards. Send only the fields that change. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirmation_token": {
          "description": "Leave out on the first call, which returns a preview and this token. Once the user approves the preview, call again with the same input plus the token.",
          "type": "string",
        },
        "desiredRoles": {
          "description": "Job titles the user is looking for, e.g. ['Frontend Engineer', 'UI Developer']. Replaces the saved list.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "jobTypes": {
          "description": "The kinds of employment the user wants: full-time, contract or internship. Replaces the saved list.",
          "items": {
            "enum": [
              "Fulltime",
              "Contract",
              "Intern",
            ],
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "maxSalary": {
          "description": "The top of the user's yearly salary range, as a plain whole number in salaryCurrency.",
          "minimum": 0,
          "type": "integer",
        },
        "minSalary": {
          "description": "The bottom of the user's yearly salary range, as a plain whole number in salaryCurrency.",
          "minimum": 0,
          "type": "integer",
        },
        "preferredLocations": {
          "description": "Where the user wants to work, e.g. ['Remote', 'Bengaluru']. City names are saved in their standard spelling. Replaces the saved list.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
        "salaryCurrency": {
          "description": "The currency of minSalary and maxSalary: ₹ rupees, $ US dollars, € euros, £ pounds, C$ Canadian dollars, A$ Australian dollars.",
          "enum": [
            "₹",
            "$",
            "€",
            "£",
            "C$",
            "A$",
          ],
          "type": "string",
        },
        "topSkills": {
          "description": "The user's main skills, e.g. ['React', 'TypeScript', 'Figma']. Replaces the saved list.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array",
        },
        "visaSponsorshipRequired": {
          "description": "true when the user needs an employer to sponsor their visa or work permit.",
          "type": "boolean",
        },
        "workStylePreferences": {
          "description": "How the user likes to work, e.g. Remote, Hybrid, On-site, Startup Environment, Fast-paced. Replaces the saved list.",
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "update_my_preferences",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "confirmation_token": {
          "description": "Send back with the same input to run it after the user approves.",
          "type": "string",
        },
        "instruction": {
          "type": "string",
        },
        "matches": {
          "description": "What happens to the user's job matches now.",
          "type": "string",
        },
        "message": {
          "description": "What happened, e.g. that the user declined and nothing was done.",
          "type": "string",
        },
        "needsConfirmation": {
          "description": "true when nothing ran yet: show preview to the user, and call again with confirmation_token once they approve.",
          "type": "boolean",
        },
        "preferredLocations": {
          "description": "The locations as saved, when they were changed.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "preview": {
          "description": "What will happen, for the user to approve.",
          "type": "string",
        },
        "updated": {
          "description": "The preferences that were changed.",
