  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Read an application form",
    },
    "description": "Read the application form of a job on GetHired (isPlatformJob), before applying with submit_application: each field's key, label, type, whether it's required and its options or limits, plus suggested answers from the user's profile and the resume that would be sent.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "description": "The GetHired job (isPlatformJob true) to read the form of: an id from search_jobs, get_relevant_jobs, get_saved_jobs or another job list.",
          "format": "uuid",
          "type": "string",
        },
      },
      "required": [
        "jobId",
      ],
      "type": "object",
    },
    "name": "get_application_form",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "canApply": {
          "type": "boolean",
        },
        "company": {
          "type": [
            "string",
            "null",
          ],
        },
        "fields": {
          "description": "The form's fields as JSON, delimited as data: each one's key, label, type, whether it's required, and its options or limits.",
          "type": "string",
        },
        "jobId": {
          "type": "string",
        },
        "notReadyReason": {
          "description": "Why the user can't apply yet, when canApply is false.",
          "type": [
            "string",
            "null",
          ],
        },
        "resume": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "string",
                },
                "name": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
              },
              "required": [
                "id",
                "name",
              ],
              "type": "object",
            },
            {
              "type": "null",
            },
          ],
          "description": "The resume that would be sent.",
        },
        "suggestedAnswers": {
          "description": "Answers taken from the user's profile, in submit_application's answers format.",
          "items": {
            "additionalProperties": true,
            "properties": {
              "choices": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "key": {
                "type": "string",
              },
              "value": {
                "type": "string",
              },
            },
            "required": [
              "key",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "title": {
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "jobId",
        "title",
        "company",
        "canApply",
        "notReadyReason",
        "resume",
        "fields",
        "suggestedAnswers",
      ],
      "type": "object",
    },
    "title": "Read an application form",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Apply to a job",
    },
    "description": "Apply to a job on GetHired for the user (Easy Apply) with their answers to its application form. Costs 1 AI credit. Read the form with get_application_form first. Only use answers the user gave or that come from their profile; ask them for anything else. GetHired asks the user to confirm before it runs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "description": "The user's answers to the form, one entry per field. Leave out optional fields the user has nothing for.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "choices": {
                "description": "For multi_select fields, in place of value: the chosen options, each written as get_application_form lists it.",
                "items": {
                  "maxLength": 120,
                  "type": "string",
                },
                "maxItems": 30,
                "type": "array",
              },
              "key": {
                "description": "Which field this answers: its key from get_application_form's fields.",
                "maxLength": 80,
                "minLength": 1,
                "type": "string",
              },
              "value": {
                "description": "The answer as text: yes or no for yes_no, digits for number, YYYY-MM-DD for date, an http(s) link for url, one of the field's options for single_select, and the amount and a 3-letter currency code for salary, e.g. 1500000 INR.",
                "maxLength": 5000,
                "type": "string",
              },
            },
            "required": [
              "key",
            ],
            "type": "object",
          },
          "maxItems": 40,
          "type": "array",
        },
        "confirmation_token": {
          "description": "Leave out on the first call, which returns a preview and this token. Once the user approves the preview, call again with the same input plus the token.",
          "type": "string",
        },
        "jobId": {
          "description": "The GetHired job to apply to: the same jobId you read the form of with get_application_form.",
          "format": "uuid",
          "type": "string",
        },
        "resumeId": {
          "description": "Which of the user's resumes to send: an id from get_resumes. Leave out to send their primary resume.",
          "format": "uuid",
          "type": "string",
        },
      },
      "required": [
        "jobId",
        "answers",
      ],
      "type": "object",
    },
    "name": "submit_application",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "applied": {
          "type": "boolean",
        },
        "company": {
          "type": [
            "string",
            "null",
          ],
        },
        "confirmation_token": {
          "description": "Send back with the same input to run it after the user approves.",
          "type": "string",
        },
        "instruction": {
          "type": "string",
        },
        "jobId": {
          "type": "string",
        },
        "message": {
          "description": "What happened, e.g. that the user declined and nothing was done.",
          "type": "string",
        },
        "needsConfirmation": {
          "description": "true when nothing ran yet: show preview to the user, and call again with confirmation_token once they approve.",
          "type": "boolean",
        },
        "preview": {
          "description": "What will happen, for the user to approve.",
          "type": "string",
        },
        "resume": {
          "description": "The name of the resume that was sent.",
          "type": [
            "string",
            "null",
          ],
        },
        "title": {
          "type": [
            "string",
            "null",
          ],
        },
        "url": {
          "description": "A full https link into GetHired.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "title": "Apply to a job",
  },
